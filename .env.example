# Required: Discord bot token from the Developer Portal.
DISCORD_TOKEN=replace-me

# Optional: register slash commands only in one guild for faster iteration.
# Use this during development. Leave empty or remove for global registration.
GUILD_ID=

# Optional: override the default data directory.
# Default is ~/.swadedsbot/
SWADEDSBOT_DATA_DIR=

# Optional: allow commands only in one channel name.
# Default is swade-bot.
SWADEDSBOT_ALLOWED_CHANNEL=

# Optional logging, examples: info, debug, swadedsbot=debug,poise=info
RUST_LOG=info
